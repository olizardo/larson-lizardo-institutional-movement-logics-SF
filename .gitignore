# Track only the code, documentation, and the data files the scripts read
# (the raw dataset plus the archived files the validation step compares
# against). Everything else — the rest of the source-data archive, the
# generated intermediates, and the outputs — is reproducible from the code.

/*
!/.gitignore
!/README.md
!/run-all.R
!/00_prep-itt-period-data.R
!/01_prep-supplementary-vars.R
!/02_mca-clustering-periods.R
!/03_figure2-years.R
!/04_figures3-6-periods.R
!/05_table3-top-sups.R
!/06_curated-tables.R
!/07_validate.R

# The archive folder must be un-ignored as a directory before its contents
# can be selectively re-included; the rules below then exclude everything
# inside it except the specific data files.
!/larson-lizardo-institutional-movement-logics-SF/
larson-lizardo-institutional-movement-logics-SF/*
!larson-lizardo-institutional-movement-logics-SF/dta/
!larson-lizardo-institutional-movement-logics-SF/csv/
larson-lizardo-institutional-movement-logics-SF/dta/*
!larson-lizardo-institutional-movement-logics-SF/dta/Full Data 2.2.dta
!larson-lizardo-institutional-movement-logics-SF/dta/ca-data-period?-1p.dta
!larson-lizardo-institutional-movement-logics-SF/dta/ca-data-two-mode-1p.dta
larson-lizardo-institutional-movement-logics-SF/csv/*
!larson-lizardo-institutional-movement-logics-SF/csv/top.sups.period?.csv

# generated by the pipeline
data-derived/
output/

# local assistant memory, not part of the repo
AGENTS.md
